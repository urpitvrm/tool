APP_ENV=development
PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
POSTGRESQL_HOST=db
POSTGRESQL_PORT=5432
POSTGRESQL_DB=siem
POSTGRESQL_USER=siem
POSTGRESQL_PASSWORD=replace-with-a-strong-password
# Use the PostgreSQL connection URI from Supabase Project Settings > Database.
# SUPABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or use DATABASE_URL for another PostgreSQL server. SUPABASE_URL takes precedence.
# DATABASE_URL=postgresql://siem:replace-with-a-strong-password@db:5432/siem
OPENSEARCH=["https://localhost:9200"]
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_REQUEST_TIMEOUT_MS=25000
OPENSEARCH_EVENTS_INDEX=wazuh-alerts-*
MANAGER=https://localhost:55000
MANAGER_USERNAME=
MANAGER_PASSWORD=
WAZUH_REQUEST_TIMEOUT_MS=30000
# Optional OpenSearch indices (Wazuh archives must be enabled to populate wazuh-archives-*)
# OPENSEARCH_ARCHIVES_INDEX=wazuh-archives-*
# OPENSEARCH_VULNERABILITIES_INDEX=wazuh-states-vulnerabilities-*
# Set when running behind a reverse proxy so rate limits see the client IP (docker-compose sets 1)
# TRUST_PROXY=1

# Public URL users open in the browser; used for secure report download links in emails
PUBLIC_BASE_URL=http://localhost:5173

# Reports
REPORT_STORAGE_DIR=./storage/reports
REPORT_MAX_ROWS=10000
REPORT_PDF_MAX_ROWS=1000
REPORT_RETENTION_DAYS=90
REPORT_LINK_TTL_HOURS=72
REPORT_EMAIL_MAX_ATTACHMENT_MB=10
# Comma-separated; when set, report emails may only go to these domains (and their subdomains)
REPORT_EMAIL_ALLOWED_DOMAINS=
REPORT_RATE_LIMIT_PER_MINUTE=10
SCHEDULE_RATE_LIMIT_PER_MINUTE=30

# Scheduler (database-backed; safe to run on several instances)
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=30000
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_STALE_JOB_MINUTES=30

# SMTP (Nodemailer). SMTP_SECURE=true for implicit TLS (port 465); STARTTLS is used automatically on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Sentinel SOC <soc-reports@example.com>"
SMTP_VERIFY_TLS=true

# Authentication (see docs/AUTHENTICATION.md)
APP_NAME="Sentinel SOC"
SUPPORT_CONTACT=security-team@example.com
# One-time token for browser setup of the first Super Administrator (remove after setup)
AUTH_SETUP_TOKEN=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
AUTH_OTP_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_PER_15_MIN=5
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_INVITATION_HOURS=72
AUTH_INVITE_REQUIRES_APPROVAL=false
AUTH_PASSWORD_HISTORY=5
AUTH_REVOKE_SESSIONS_ON_PASSWORD_CHANGE=true
AUTH_NOTIFY_EVERY_LOGIN=false
AUTH_LOGIN_HISTORY_DAYS=365
# Defaults to true when APP_ENV=production (requires HTTPS)
# AUTH_COOKIE_SECURE=true
# Development only: skip the sign-in email code when no SMTP server is available
# AUTH_LOGIN_OTP_ENABLED=false
