APP_ENV=development
PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
POSTGRESQL_HOST=db
POSTGRESQL_PORT=5432
POSTGRESQL_DB=siem
POSTGRESQL_USER=siem
POSTGRESQL_PASSWORD=replace-with-a-strong-password
# Use the PostgreSQL connection URI from Supabase Project Settings > Database.
# SUPABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or use DATABASE_URL for another PostgreSQL server. SUPABASE_URL takes precedence.
# DATABASE_URL=postgresql://siem:replace-with-a-strong-password@db:5432/siem
OPENSEARCH=["https://localhost:9200"]
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_EVENTS_INDEX=wazuh-alerts-*
MANAGER=https://localhost:55000
MANAGER_USERNAME=
MANAGER_PASSWORD=
